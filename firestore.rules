rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function isParticipant(data) {
      let ids = data.get('participantIds', []);
      return isAuthed() && request.auth.uid in (ids is list ? ids : []);
    }

    function isJoiningLobby() {
      return isAuthed()
        && resource.data.status == 'lobby'
        && request.resource.data.participantIds is list
        && request.auth.uid in request.resource.data.participantIds
        && !(request.auth.uid in (resource.data.participantIds is list ? resource.data.participantIds : []));
    }

    match /rooms/{roomId} {
      // Allow reading non-existing rooms (for code availability check during creation)
      // or existing lobby rooms, or if you are a participant.
      allow read: if isAuthed() && (
        !resource || resource.data.status == 'lobby' || isParticipant(resource.data)
      );

      // Creation is only allowed if you set yourself as the sole initial participant and host.
      // The client code always enforces this.
      allow create: if isAuthed()
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.participantIds is list
        && request.resource.data.participantIds.size() == 1
        && request.resource.data.participantIds[0] == request.auth.uid;

      allow update: if isAuthed() && (
        isParticipant(resource.data) || isJoiningLobby() ||
        (resource.data.updatedAt != null && resource.data.updatedAt < request.time - duration.value(5, "min"))
      );

      allow delete: if isAuthed() && (
        isParticipant(resource.data) ||
        (resource.data.updatedAt != null && resource.data.updatedAt < request.time - duration.value(5, "min"))
      );

      match /leagueData/{docId} {
        function parentRoom() {
          return get(/databases/$(database)/documents/rooms/$(roomId)).data;
        }

        allow read: if isAuthed() && isParticipant(parentRoom());
        allow write: if isAuthed()
          && request.auth.uid == parentRoom().hostId
          && isParticipant(parentRoom());
      }
    }
  }
}